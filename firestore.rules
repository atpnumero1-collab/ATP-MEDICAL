rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Doctors collection
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isValidId(doctorId);
    }

    // Patients collection
    match /patients/{patientId} {
      allow read: if true;
      allow write: if isValidId(patientId);
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if true;
      allow write: if isValidId(appointmentId);
    }

    // Intakes / Tickets in real time
    match /intakes/{intakeId} {
      allow read: if true;
      allow write: if isValidId(intakeId);
    }

    // Clinic Configuration
    match /config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }

    // Medical Records collection
    match /medicalRecords/{recordId} {
      allow read: if true;
      allow write: if isValidId(recordId);
    }


    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
